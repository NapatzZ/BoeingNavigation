FROM osrf/ros:humble-desktop-full

ENV DEBIAN_FRONTEND=noninteractive

# ===============================
# Basic tools + librealsense2 build deps
# ===============================
RUN apt-get update && apt-get install -y \
    software-properties-common \
    apt-transport-https \
    wget \
    curl \
    git \
    vim \
    byobu \
    build-essential \
    cmake \
    python3-colcon-common-extensions \
    python3-rosdep \
    libeigen3-dev \
    libssl-dev \
    libusb-1.0-0-dev \
    libudev-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# ===============================
# Initialize rosdep
# ===============================
RUN rosdep init || true
RUN rosdep update

# ===============================
# Intel RealSense SDK — built from source (no apt key required)
# Pinned to v2.56.5 to match realsense-ros 4.56.1
# FORCE_RSUSB_BACKEND=ON uses a pure userspace USB backend, no kernel patching
# ===============================
RUN git clone https://github.com/IntelRealSense/librealsense.git \
        --depth 1 -b v2.56.5 \
    && cd librealsense \
    && mkdir build && cd build \
    && cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DFORCE_RSUSB_BACKEND=ON \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_GRAPHICAL_EXAMPLES=OFF \
    && make -j$(nproc) \
    && make install \
    && ldconfig \
    && cd / && rm -rf librealsense

# ===============================
# ROS packages via apt
# ===============================
RUN apt-get update && apt-get install -y \
    ros-humble-slam-toolbox \
    ros-humble-tf2 \
    ros-humble-tf2-ros \
    ros-humble-tf2-msgs \
    ros-humble-kobuki-ros-interfaces \
    ros-humble-kobuki-velocity-smoother \
    ros-humble-sophus \
    ros-humble-teleop-twist-keyboard \
    ros-humble-joy-teleop \
    ros-humble-teleop-twist-joy \
    ros-humble-twist-mux \
    ros-humble-spatio-temporal-voxel-layer \
    && rm -rf /var/lib/apt/lists/*

# ===============================
# Create ROS2 workspace
# ===============================
WORKDIR /root/skuba_ws
RUN mkdir -p src

# ===============================
# Clone repositories built into the image
# ===============================
WORKDIR /root/skuba_ws/src

# Navigation2
RUN git clone https://github.com/ros-navigation/navigation2.git -b humble

# RealSense ROS2 wrapper — pinned to match librealsense2 v2.56.5 above
RUN git clone https://github.com/IntelRealSense/realsense-ros.git -b 4.56.1

# Kobuki driver — baked into image (Method C).
# ecl packages require rosdep to install ecl_build first, then
# colcon must build sequentially (ecl_mpl depends on ecl_build being built first).
RUN git clone https://github.com/NapatzZ/skuba-kobuki-driver.git

# ===============================
# Placeholder dirs for volume-mounted packages
# These are empty at image build time; real source is bind-mounted at runtime
# via docker-compose.yml so host git pulls are reflected inside the container
# ===============================
RUN mkdir -p \
    skuba_navigation \
    skuba_bringup \
    skuba_interfaces \
    skuba_description

# ===============================
# rosdep install (only covers cloned packages; mounted dirs are empty)
# ===============================
WORKDIR /root/skuba_ws
RUN apt-get update \
    && rosdep install --from-paths src --ignore-src -r -y \
    && rm -rf /var/lib/apt/lists/*

# ===============================
# Build workspace (navigation2 + realsense-ros + kobuki driver)
# --executor sequential: ecl packages (kobuki deps) must build in order
# (ecl_build → ecl_mpl → … → kobuki_node); parallel build breaks the chain.
# After starting the container, mount packages and run colcon build again.
# ===============================
RUN /bin/bash -c "\
    source /opt/ros/humble/setup.bash && \
    colcon build \
      --symlink-install \
      --executor sequential \
      --cmake-args -DCMAKE_BUILD_TYPE=Release \
    "

# ===============================
# Source on container startup
# ===============================
RUN echo "source /opt/ros/humble/setup.bash" >> ~/.bashrc && \
    echo "source /root/skuba_ws/install/setup.bash" >> ~/.bashrc

# ===============================
# Entrypoint: auto source + build mounted packages on every startup
# build/ and install/ are on named volumes so only changed packages rebuild
# ===============================
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /root/skuba_ws
ENTRYPOINT ["/entrypoint.sh"]
CMD ["/bin/bash"]
