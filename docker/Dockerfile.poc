FROM osrf/ros:humble-desktop-full

ENV DEBIAN_FRONTEND=noninteractive

# Base tools
RUN apt-get update && apt-get install -y \
    software-properties-common \
    apt-transport-https \
    wget \
    curl \
    git \
    vim \
    byobu \
    build-essential \
    cmake \
    python3-colcon-common-extensions \
    python3-rosdep \
    libeigen3-dev \
    libssl-dev \
    libusb-1.0-0-dev \
    libudev-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN rosdep init || true
RUN rosdep update

# ROS 2 nav stack + twist_mux + foxglove (kobuki built from source below)
RUN apt-get update && apt-get install -y \
    ros-humble-nav2-bringup \
    ros-humble-slam-toolbox \
    ros-humble-tf2 \
    ros-humble-tf2-ros \
    ros-humble-tf2-msgs \
    ros-humble-teleop-twist-keyboard \
    ros-humble-joy-teleop \
    ros-humble-teleop-twist-joy \
    ros-humble-twist-mux \
    ros-humble-spatio-temporal-voxel-layer \
    ros-humble-foxglove-bridge \
    && rm -rf /var/lib/apt/lists/*

# Clone public deps only
WORKDIR /ros_ws/src
RUN git clone https://github.com/Slamtec/sllidar_ros2.git
# nav2_bringup not in apt, build from source
RUN git clone https://github.com/ros-navigation/navigation2.git -b humble
# kobuki: interfaces, velocity_smoother, core driver (no apt packages in Humble)
RUN git clone https://github.com/kobuki-base/kobuki_ros.git -b humble
RUN git clone https://github.com/kobuki-base/kobuki.git -b humble
RUN git clone https://github.com/NapatzZ/skuba-kobuki-driver.git

WORKDIR /ros_ws

# Install rosdeps for public deps
RUN apt-get update \
    && rosdep install --from-paths src --ignore-src -r -y \
    && rm -rf /var/lib/apt/lists/*

# Build public deps
RUN /bin/bash -c "\
    source /opt/ros/humble/setup.bash && \
    colcon build \
     --symlink-install \
     --executor sequential \
     --cmake-args -DCMAKE_BUILD_TYPE=Release \
    "

# Auto-source on shell start
RUN echo "source /opt/ros/humble/setup.bash" >> ~/.bashrc && \
    echo "source /ros_ws/install/setup.bash" >> ~/.bashrc

COPY docker/entrypoint.poc.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /ros_ws
ENTRYPOINT ["/entrypoint.sh"]
CMD ["/bin/bash"]